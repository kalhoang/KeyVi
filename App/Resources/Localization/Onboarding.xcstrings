{
  "sourceLanguage" : "vi",
  "strings" : {
    "onboarding.conflicts.body" : {
      "comment" : "PRD-R40 screen 5. %@ is the other app.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two input methods at once duplicate or drop letters. Quit %@ and stop it from opening at login."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai bộ gõ cùng lúc sẽ làm lặp hoặc mất chữ. Bạn nên thoát %@ và tắt nó khi đăng nhập."
          }
        }
      }
    },
    "onboarding.conflicts.builtIn" : {
      "comment" : "PRD-R40 built-in source. %@ is the app name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can keep or remove the macOS Vietnamese input source. While using %@, choose the ABC or U.S. keyboard."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể giữ hoặc gỡ bộ gõ Tiếng Việt của macOS. Khi dùng %@, hãy chọn bàn phím ABC hoặc U.S."
          }
        }
      }
    },
