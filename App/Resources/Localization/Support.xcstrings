{
  "sourceLanguage" : "vi",
  "strings" : {
    "support.about.description" : {
      "comment" : "About pane, under the name and version.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A free Vietnamese input method for the Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ gõ tiếng Việt miễn phí cho máy Mac."
          }
        }
      }
    },
    "support.autoCheck.explanation" : {
      "comment" : "PRD-R25, PLT-R906.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks once a day. Only the list of updates is downloaded; nothing about you is sent."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra mỗi ngày một lần. Chỉ tải danh sách bản cập nhật, không gửi thông tin gì về bạn."
          }
        }
      }
    },
    "support.autoCheck.title" : {
      "comment" : "D19.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check for updates automatically"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động kiểm tra cập nhật"
          }
        }
      }
    },
    "support.autoInstall.explanation" : {
      "comment" : "PRD-R25, PRD-R50.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installs when you quit or restart, never while you are typing."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài khi bạn thoát hoặc khởi động lại máy, không bao giờ giữa lúc đang gõ."
          }
        }
      }
    },
    "support.autoInstall.title" : {
