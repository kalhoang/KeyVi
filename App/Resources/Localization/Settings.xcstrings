    "settings.typing.restoreHotkey.explanation" : {
      "comment" : "PRD-R18, PRD-R25.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brings the last word back to the keys you typed. The default is Escape. Pressing it again right away passes the key through as usual, so Escape still closes dialogs. It is off automatically in terminals, code editors, games and remote desktop apps."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đưa từ vừa gõ về đúng các phím bạn đã gõ. Mặc định là Escape. Bấm thêm lần nữa ngay sau đó thì phím được gửi đi như bình thường, nên Escape vẫn đóng được hộp thoại. Phím này tự tắt trong Terminal, trình soạn mã, trò chơi và ứng dụng điều khiển máy từ xa."
          }
        }
