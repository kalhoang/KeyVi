{
  "sourceLanguage" : "vi",
  "strings" : {
    "support.autoCheck.explanation" : {
      "comment" : "PRD-R25, PLT-R906.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks once a day. Only the list of updates is downloaded; nothing about you is sent."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra mỗi ngày một lần. Chỉ tải danh sách bản cập nhật, không gửi thông tin gì về bạn."
          }
        }
      }
    },
    "support.autoCheck.title" : {
      "comment" : "D19.",
