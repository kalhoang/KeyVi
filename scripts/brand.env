# Brand values for shell scripts. Must match Config/Brand.xcconfig (scripts/rename-app.sh keeps both in sync).
# The name is TEMPORARY; Pa will choose the final name.
APP_DISPLAY_NAME="KeyVi"
APP_SLUG="keyvi"
APP_BUNDLE_ID_RELEASE="vn.kal.keyvi"
APP_BUNDLE_ID_DEV="vn.kal.keyvi.dev"
APP_SITE_HOST="keyvi.kal.vn"
# Optional values, empty until Pa decides (VERIFY). Same meaning as in Config/Brand.xcconfig.
# Support address for "Gửi qua email" (PRD-R47); its domain is allowed by scripts/check-url-hosts.sh (QA-R60).
APP_SUPPORT_EMAIL="keyvi@kal.vn"
# Public repository as a plain URL, https://github.com/<owner>/<repo> (the xcconfig spells it https:/$()/...).
# Its host replaces the github.com default of scripts/check-url-hosts.sh (QA-R60).
APP_REPOSITORY_URL=""
# Storage folder names of earlier product names, newest first, `;`-separated (ADR 0307). Maintained by
# scripts/rename-app.sh; never edit by hand.
APP_LEGACY_STORAGE_FOLDER_NAMES=""
