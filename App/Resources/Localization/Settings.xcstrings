    "settings.general.openAtLogin.failed" : {
      "comment" : "register() or unregister() failed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not change open at login. Try again, or turn it on in System Settings."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đổi được tùy chọn mở khi đăng nhập. Hãy thử lại, hoặc bật trong Cài đặt hệ thống."
          }
        }
      }
    },
    "settings.general.openAtLogin.manual" : {
      "comment" : "macOS 12 only (ADR 0315): the app cannot add itself to the login items there. %1$@ is the app name; %2$@, %3$@ and %4$@ are the System Preferences, Users & Groups and Login Items names in the macOS language (SystemPanes.json).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On macOS 12, %1$@ cannot turn this on by itself. Open %2$@ > %3$@ > %4$@, click the plus (+) button and choose %1$@ in the Applications folder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên macOS 12, %1$@ không tự bật được tùy chọn này. Hãy mở %2$@ > %3$@ > %4$@, bấm nút cộng (+) rồi chọn %1$@ trong thư mục Ứng dụng."
          }
        }
      }
    },
    "settings.general.openAtLogin.notFound" : {
      "comment" : "Login item not found. %@ is the app name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS cannot find %@ to open at login. Make sure the app is in the Applications folder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS chưa nhận ra %@ để mở khi đăng nhập. Hãy chắc rằng ứng dụng nằm trong thư mục Ứng dụng."
          }
        }
      }
    },
    "settings.general.openAtLogin.openSystemPreferences" : {
      "comment" : "Button, macOS 12 only (ADR 0315). %@ is the System Preferences name in the macOS language (SystemPanes.json, PRD-R64), the same words as in the note above it.",
