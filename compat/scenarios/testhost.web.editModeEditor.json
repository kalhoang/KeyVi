{
  "$schema": "../schema/scenario.schema.json",
  "id": "testhost.web.editModeEditor",
  "targetBundleId": "local.testhost",
  "setup": [
    {
      "action": "launch"
    },
    {
      "action": "setSecureInput",
      "value": "off"
    },
    {
      "action": "openURL",
      "value": "{pages}/edit-mode-editor.html"
    },
    {
      "action": "wait",
      "value": "1000"
    },
    {
      "action": "focusField",
      "value": "testhost.web.input"
    }
  ],
  "keys": [
    "shift+d",
    "d"
  ],
  "timing": "normal",
  "method": "telex",
  "layout": "com.apple.keylayout.ABC",
  "expect": {
    "text": "Đức"
  },
  "readback": "ax"
}
