{
  "sourceLanguage" : "vi",
  "strings" : {
    "secureInputHint.browser.passwordField" : {
      "comment" : "PLT-R397 browser hint.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browser: click outside the password field or switch tabs."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình duyệt: bấm ra ngoài ô mật khẩu hoặc chuyển sang thẻ khác."
          }
        }
      }
    },
    "secureInputHint.iterm2.secureKeyboardEntry" : {
      "comment" : "PLT-R398C iTerm2 hint. VERIFY the setting name in the current iTerm2.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2: turn off Secure Keyboard Entry in the iTerm2 menu, and turn off the option that turns it on at password prompts in iTerm2's settings."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2: tắt Secure Keyboard Entry trong menu iTerm2, và tắt tùy chọn tự bật khi thấy lời nhắc mật khẩu trong cài đặt của iTerm2."
          }
        }
      }
    },
    "secureInputHint.terminal.secureKeyboardEntry" : {
      "comment" : "PLT-R397 Terminal hint. VERIFY the menu item name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal: turn off Secure Keyboard Entry in the Terminal menu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal: tắt mục Nhập bàn phím bảo mật trong menu Terminal."
          }
        }
      }
    },
