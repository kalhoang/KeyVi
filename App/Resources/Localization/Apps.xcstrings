    "apps.paste.body" : {
      "comment" : "PLT-R461, PLT-R462 failure modes. %@ is the app name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In this mode, %@ puts the text on the clipboard, pastes it into the app, then restores what was there. Possible problems: the app reads the clipboard after it was restored and pastes the old content; a remote desktop client has clipboard sync turned off; the app blocks Command+V sent by software."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở chế độ này, %@ ghi chữ vào bộ nhớ tạm, dán vào ứng dụng, rồi khôi phục nội dung cũ. Có thể gặp: ứng dụng đọc bộ nhớ tạm sau khi đã khôi phục nên dán nội dung cũ; ứng dụng điều khiển máy từ xa đã tắt đồng bộ bộ nhớ tạm; ứng dụng chặn Command + V do phần mềm gửi."
          }
        }
      }
    },
