    "support.privacy.body" : {
      "comment" : "Pa's wording (15/11/2026), spelling \"gởi\" as Pa wrote it. %@ is the name with its trademark sign.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ keeps its information on this Mac only. It does not store what you write and never sends your activity to a server without your consent. The only network connection is the update check."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ chỉ lưu thông tin ở máy hiện hành và không lưu nội dung bạn viết cũng như không tự ý gởi về server các hoạt động mà không có sự đồng ý của người dùng. Kết nối mạng duy nhất là kiểm tra cập nhật."
