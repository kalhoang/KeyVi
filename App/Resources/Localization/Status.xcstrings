            "value" : "Tìm hiểu thêm"
          }
        }
      }
    },
    "status.action.overrideTextFocus" : {
      "comment" : "PLT-R540 one-click override. %@ is the frontmost app.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep typing Vietnamese in %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẫn gõ tiếng Việt trong %@"
          }
        }
      }
    },
    "status.action.reopenApp" : {
      "comment" : "ADR 0309. %@ is the app name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reopen %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở lại %@"
          }
        }
      }
    },
    "status.action.reportProblem" : {
      "comment" : "PRD-R43 action.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Report a problem..."
          }
