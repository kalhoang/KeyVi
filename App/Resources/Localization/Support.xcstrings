    "support.donate.body" : {
      "comment" : "PRD-R59 (verbatim). %@ is the app name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is free and always will be. If you find it useful, you can support it so Kal has more time to keep building."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ miễn phí và sẽ luôn miễn phí. Nếu thấy có ích, bạn có thể ủng hộ để Kal có thêm thời gian làm tiếp."
          }
        }
      }
    },
    "support.donate.scanHint" : {
      "comment" : "Below the VietQR code (S8): the payer's bank app shows the recipient's name after the scan.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the code with your banking app. It shows the recipient's name so you can check it before you send."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quét mã bằng ứng dụng ngân hàng. Ứng dụng sẽ hiện tên người nhận để bạn kiểm tra trước khi chuyển."
          }
        }
      }
    },
