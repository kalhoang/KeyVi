    "apps.compat.automatic.explanation" : {
      "comment" : "PRD-R36 one sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the method chosen for this app automatically."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng cách gõ được chọn sẵn cho ứng dụng này."
          }
        }
      }
    },
    "apps.compat.explanation" : {
      "comment" : "PRD-R36.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change this only if typing goes wrong in this app. Your choice is attached to your next report for this app."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ đổi khi chữ gõ trong ứng dụng này bị sai. Lựa chọn của bạn được gửi kèm lần báo lỗi tiếp theo cho ứng dụng này."
          }
        }
      }
    },
    "apps.compat.guidedTest" : {
      "comment" : "PRD-R36, PLT-R540: shown instead of a choice while a guided test result is in force for the app.",
      "extractionState" : "manual",
