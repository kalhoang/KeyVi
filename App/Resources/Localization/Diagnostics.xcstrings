    "bugReport.description.accessibilityHint" : {
      "comment" : "VoiceOver hint (PRD-R66).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type the example you want to include. Used only in the report you send yourself."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gõ ví dụ bạn muốn gửi kèm. Chỉ dùng trong báo lỗi bạn tự gửi."
          }
        }
      }
    },
    "bugReport.description.hint" : {
      "comment" : "PRD-R47 item 3 hint; argument is the app name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type the example again here yourself. %@ does not send what you typed on its own."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn tự gõ lại ví dụ ở đây. %@ không tự gửi những gì bạn đã gõ."
          }
        }
      }
    },
    "bugReport.description.label" : {
      "comment" : "PRD-R47 item 3.",
      "extractionState" : "manual",
