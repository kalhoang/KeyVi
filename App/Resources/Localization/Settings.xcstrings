    "settings.typing.typoCorrection.disabledSuffix" : {
      "comment" : "Ends the D30 explanation while D4 is off and the row is disabled (PRD-R80), verbatim; it names the D4 row by its title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Automatic English restore to use this."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật Tự khôi phục từ tiếng Anh để dùng."
          }
        }
      }
    },
    "settings.typing.typoCorrection.explanation" : {
      "comment" : "D30 explanation (PRD-R80), verbatim. %@ is the app name; Escape is the default restore key (D8). Q10 (ADR 0010 item 1): a sentence-case word at a sentence start is corrected, so the copy says \"từ viết hoa toàn bộ\" / \"words in all capitals\"; under the other answer it would say \"từ viết hoa\" / \"capitalised words\" (scripts/tests/test_correction_policy.py).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you mistype an English word (androdi, gramar), %@ replaces it with the one word it can be (android, grammar) as you type the space. Vietnamese words, words in all capitals and anything typed in Terminal are never changed. Press Escape right after to get the word you typed back."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gõ nhầm một từ tiếng Anh (androdi, gramar) thì %@ sửa thành từ đúng (android, grammar) khi bạn gõ dấu cách. Không sửa từ tiếng Việt, từ viết hoa toàn bộ hay chữ gõ trong Terminal. Nhấn Escape ngay sau đó để lấy lại từ bạn đã gõ."
          }
        }
      }
    },
    "settings.typing.typoCorrection.explanationNoKey" : {
      "comment" : "D30 explanation when the restore key (D8) is off (PRD-R80, PRD-R78): no word is corrected without a key to take it back (ENG-R1119). %@ is the app name. The Q10 words as in the explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you mistype an English word (androdi, gramar), %@ replaces it with the one word it can be (android, grammar) as you type the space. Vietnamese words, words in all capitals and anything typed in Terminal are never changed. Words are corrected only while the restore-last-word key is on. That key is off in Advanced options."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gõ nhầm một từ tiếng Anh (androdi, gramar) thì %@ sửa thành từ đúng (android, grammar) khi bạn gõ dấu cách. Không sửa từ tiếng Việt, từ viết hoa toàn bộ hay chữ gõ trong Terminal. Chỉ sửa khi phím khôi phục từ vừa gõ được bật. Phím này đang tắt trong Tùy chọn nâng cao."
          }
        }
      }
    },
    "settings.typing.typoCorrection.explanationOtherKey" : {
      "comment" : "D30 explanation when the restore key (D8) is not Escape (PRD-R80, PRD-R78). %1$@ is the app name, %2$@ the key in words. The Q10 words as in the explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you mistype an English word (androdi, gramar), %1$@ replaces it with the one word it can be (android, grammar) as you type the space. Vietnamese words, words in all capitals and anything typed in Terminal are never changed. Press the restore-last-word key (%2$@) right after to get the word you typed back."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gõ nhầm một từ tiếng Anh (androdi, gramar) thì %1$@ sửa thành từ đúng (android, grammar) khi bạn gõ dấu cách. Không sửa từ tiếng Việt, từ viết hoa toàn bộ hay chữ gõ trong Terminal. Nhấn phím khôi phục từ vừa gõ (%2$@) ngay sau đó để lấy lại từ bạn đã gõ."
          }
        }
      }
    },
    "settings.typing.typoCorrection.title" : {
