{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: LicenseRef-App-Pending. Shape of site/data/releases.json as read by site/build.mjs. scripts/publish-release writes it. Aliases accepted by the reader: dmgUrl|dmg_url|url|dmg.url, dmgSha256|dmg.sha256, minimum_system_version.",
  "title": "Site releases file",
  "type": "object",
  "required": ["releases"],
  "properties": {
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "channel", "date", "dmgUrl", "sha256", "minimumSystemVersion"],
        "properties": {
          "version": { "type": "string", "description": "CFBundleShortVersionString, semver (a -beta.N suffix is allowed)" },
          "build": { "type": ["integer", "string"], "description": "CFBundleVersion" },
          "channel": { "enum": ["stable", "beta"] },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "dmgUrl": { "type": "string", "pattern": "^https://", "description": "Entries without an https (or site-relative) URL are skipped" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "minimumSystemVersion": { "type": "string", "examples": ["15.0"] },
          "notes": {
            "type": "object",
            "properties": { "vi": { "type": "string" }, "en": { "type": "string" } }
          }
        }
      }
    }
  }
}
