// SPDX-License-Identifier: GPL-3.0-or-later
// Single source of the product name, final since 2026-11-13 (docs/decisions/0005-pa-decisions-2026-11-13.md).
// Rename with: scripts/rename-app.sh "<Display Name>" <slug>
// Never hard-code the display name, slug or bundle ID anywhere else in code or UI strings.

APP_DISPLAY_NAME = KeyVi
APP_SLUG = keyvi
APP_BUNDLE_ID_RELEASE = vn.kal.keyvi
APP_BUNDLE_ID_DEV = vn.kal.keyvi.dev
APP_SITE_HOST = keyvi.kal.vn

// Added 2026-11-13 by the platform design (review findings on PRD-R47, QA-R51, QA-R60 and the temporary
// name). The values above are unchanged. Empty means "not decided yet"; Pa fills them (VERIFY).
// Support address for "Gửi qua email" (PRD-R47). Empty hides the email button.
APP_SUPPORT_EMAIL = keyvi@kal.vn
// Public GitHub repository for issue forms (PRD-R47) and the URL host allowlist (QA-R60). Write it as
// https:/$()/github.com/<owner>/<repo> because `//` starts an xcconfig comment. Empty hides the GitHub button.
APP_REPOSITORY_URL =
// Storage folder names of earlier product names, newest first, separated by `;` (ADR 0307). scripts/rename-app.sh
// appends the old folder name here so the first launch after a rename moves settings and logs.
APP_LEGACY_STORAGE_FOLDER_NAMES =