    "trace.confirm.message" : {
      "comment" : "PLT-R905 confirmation; arguments are the app name and the duration.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ records the keys you type, including letters, for %2$ld seconds. The menu bar icon changes and a countdown with a Stop button stays on screen while it records. Nothing is recorded while you enter a password. The trace stays on this Mac, is deleted after 24 hours or as soon as you export or discard it, and is never sent anywhere automatically."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sẽ ghi lại các phím bạn gõ, kể cả chữ, trong %2$ld giây. Biểu tượng trên thanh menu đổi và một bảng đếm ngược có nút Dừng hiện suốt lúc ghi. Không ghi gì khi đang nhập mật khẩu. Bản ghi chỉ nằm trên máy này, bị xóa sau 24 giờ hoặc ngay khi bạn xuất hay bỏ, và không bao giờ tự gửi đi."
          }
        }
      }
    },
    "trace.confirm.start" : {
