{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compat/schema/matrix.schema.json",
  "title": "Compatibility verification matrix (compat/matrix.json)",
  "description": "02-platform.md 13.3 and 04-quality-release.md QA-R17. Verification status only; behaviour lives in rules.json. Twin of CompatRules/Matrix.swift. License: LicenseRef-App-Pending.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "isoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "date", "tester"],
      "properties": {
        "result": { "enum": ["pass", "fail", "n/a"] },
        "date": { "$ref": "#/$defs/isoDate" },
        "tester": { "type": "string" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleId", "displayName", "category", "status", "issues"],
      "properties": {
        "bundleId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$" },
        "displayName": { "type": "string" },
        "category": { "enum": ["browser", "office", "chat", "notes", "developer", "terminal", "design", "launcher", "remote", "game", "system", "other"] },
        "tier": { "enum": [1, 2] },
        "ruleId": { "type": "string" },
        "status": { "enum": ["works", "worksWithNotes", "notVerified", "knownLimitation"] },
        "note": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vi", "en"],
          "properties": { "vi": { "type": "string" }, "en": { "type": "string" } }
        },
        "lastVerified": { "$ref": "#/$defs/isoDate" },
        "appVersion": { "type": "string" },
        "macOS": { "type": "string" },
        "verifier": { "type": "string" },
        "issues": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "telexBasic": { "$ref": "#/$defs/cell" },
            "vniBasic": { "$ref": "#/$defs/cell" },
            "inlineCompletion": { "$ref": "#/$defs/cell" },
            "burstTyping": { "$ref": "#/$defs/cell" },
            "backspaceReentry": { "$ref": "#/$defs/cell" },
            "restoreHotkey": { "$ref": "#/$defs/cell" },
            "perAppMemory": { "$ref": "#/$defs/cell" },
            "macroExpansion": { "$ref": "#/$defs/cell" }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "status": { "enum": ["works", "worksWithNotes"] } } }, "then": { "required": ["lastVerified", "appVersion", "macOS", "verifier"] } },
        { "if": { "properties": { "status": { "enum": ["worksWithNotes", "knownLimitation"] } } }, "then": { "required": ["note"] } }
      ]
    }
  }
}
