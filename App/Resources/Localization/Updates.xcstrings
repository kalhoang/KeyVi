{
  "sourceLanguage" : "vi",
  "strings" : {
    "updates.channel.stableNoDowngrade" : {
      "comment" : "PRD-R53: shown in the About pane after switching from Beta to Stable. %@ is the app name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will get the next stable version as soon as it is newer than the one you use. %@ never goes back to an older version on its own."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ nhận bản ổn định tiếp theo khi bản đó mới hơn bản bạn đang dùng. %@ không tự quay về bản cũ hơn."
          }
        }
      }
    },
    "updates.control.close.accessibilityHint" : {
      "comment" : "VoiceOver hint of the Close button (PRD-R66).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closes this message. You keep using the current version."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đóng thông báo này. Bạn tiếp tục dùng bản hiện tại."
          }
        }
      }
    },
    "updates.control.close.accessibilityLabel" : {
      "comment" : "VoiceOver label of the Close button (PRD-R66).",
