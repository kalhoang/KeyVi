    "diagnostics.clipboardNotice" : {
      "comment" : "PRD-R48, shown before any clipboard write on every report surface. %1$@ is the list of the buttons on screen that write to the clipboard (joined with diagnostics.buttons.*), %2$@ is the app name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you click %1$@, %2$@ puts the data on the clipboard for you to paste. Apart from the paste compatibility mode you turn on yourself, this is the only time %2$@ writes to the clipboard."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn bấm %1$@, %2$@ chép dữ liệu vào bộ nhớ tạm để bạn dán. Ngoài chế độ tương thích dán do bạn tự bật, đây là lúc duy nhất %2$@ ghi vào bộ nhớ tạm."
          }
        }
      }
    },
